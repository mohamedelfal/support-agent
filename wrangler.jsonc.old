{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "support-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  
  "migrations": [
    {
      "tag": "v1",
      "deleted_classes": ["CircuitBreaker"]
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "support-agent-db",
      "database_id": "d3daf930-ea18-41cc-ac8a-5ba19166281c"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "7ad7739ad018433f91f9435ca70fa6b2"
    }
  ]
}
